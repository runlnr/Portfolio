{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "js/**/*",
    "types/**/*",
    "data/**/*"
  ],
  "exclude": [
    "node_modules",
    "js/vendor"
  ]
}
